NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-local-secret-at-least-32-characters
DATABASE_URL=postgres://flowyn:flowyn@localhost:5432/flowyn
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSION=768
AI_PROVIDER=ollama
AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=800
AI_REQUEST_TIMEOUT_MS=60000
MAX_GENERATION_PROMPT_CHARS=12000
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
MAX_KNOWLEDGE_DOCUMENT_CHARS=200000
RAG_MAX_CONTEXT_CHARS=8000
RAG_TOP_K=5
